# RoadLifter Client Environment Variables
# Copy this file to .env.local and fill in your actual values

# Next.js Configuration
NEXT_PUBLIC_API_URL= http://localhost:5000
NEXT_PUBLIC_WS_URL=  http://localhost:5000
NEXT_PUBLIC_APP_NAME=RoadLifter
NEXT_PUBLIC_APP_URL= http://localhost:3000

# Firebase Web app config (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your-actual-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=roadlifter-e3a3b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=roadlifter-e3a3b
NEXT_PUBLIC_FIREBASE_APP_ID=your-actual-app-id

