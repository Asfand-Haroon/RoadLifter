# RoadLifter Server Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Required in production (no defaults — server will refuse to start if either is unset)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-admin-password

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/roadlifter

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-characters
TRUST_PROXY=false

# Firebase Admin SDK service-account JSON (keep private; never use a NEXT_PUBLIC_ variable)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_PING_INTERVAL=25000